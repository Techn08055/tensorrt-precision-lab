# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# OS junk
.DS_Store
Thumbs.db
*.log

# Large / regenerable model artifacts — see README "Reproduce" (export.py, build_and_bench.py, calibrate_int8.py)
models/*.onnx
models/*.onnx.data
models/*.pth
resnet/fp32/*.engine
resnet/fp16/*.engine
resnet/int8/*.engine
resnet/selective_int8/*.engine
calibration/calibration.cache

# Compiled CUDA binaries — rebuild with the nvcc command in each module's docs/README
gemm/src/gemm_naive

# Large binary Nsight traces — the small *_cuda_gpu_kern_sum.csv summaries are kept, they're the actual cited evidence
profiling/nsys/*.nsys-rep

# Video production: each videos/NN_.../ is a separate Remotion project (its own git repo
# and .gitignore) plus dossier/storyboard/script/planning docs and raw narration audio.
# Not part of the TensorRT/CUDA experiment side of this repo.
videos/
audio/
